# MPC Orchestrator Configuration

# ==========================================
# Server Settings
# ==========================================
PORT=8081
ENABLE_PLAYGROUND=true
ENABLE_INTROSPECTION=true
SERVER_READ_TIMEOUT=30s
SERVER_WRITE_TIMEOUT=30s
MAX_QUERY_CACHE_SIZE=1000
MAX_APQ_CACHE_SIZE=100
WEBSOCKET_PING_INTERVAL=10s

# ==========================================
# CORS Settings
# ==========================================
# Пусто = разрешить все origins (только для development!)
# Production: укажите конкретные домены через запятую
ALLOWED_ORIGINS=

# ==========================================
# Session Settings
# ==========================================
SESSION_MAX_ITERATIONS=100
SESSION_ITERATION_SLEEP_MS=100
SESSION_INIT_SLEEP_MS=1000
SESSION_NO_MESSAGE_TIMEOUT=30
SESSION_REQUEST_TIMEOUT_SEC=10

# ==========================================
# TLS/mTLS Settings (КРИТИЧНО для production!)
# ==========================================
# Включить TLS для gRPC соединений с нодами
TLS_ENABLED=false

# Пути к сертификатам (если TLS_ENABLED=true)
TLS_CERT_FILE=certs/client.crt
TLS_KEY_FILE=certs/client.key
TLS_CA_FILE=certs/ca.crt

# ServerName для верификации (опционально)
# Если пусто, используется адрес из dial
TLS_SERVER_NAME=

# ==========================================
# Logging Settings
# ==========================================
LOG_FORMAT=text
LOG_LEVEL=INFO

# ==========================================
# Production Settings
# ==========================================
# Для production рекомендуется:
#
# ENABLE_PLAYGROUND=false
# ENABLE_INTROSPECTION=false
# TLS_ENABLED=true
# LOG_FORMAT=json
# LOG_LEVEL=INFO
# ALLOWED_ORIGINS=https://your-domain.com
