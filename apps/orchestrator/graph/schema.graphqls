# GraphQL схема для MPC Оркестратора
# Управляет MPC нодами и координирует TSS операции

# ============================================
# Управление нодами
# ============================================

enum NodeStatus {
  ONLINE
  OFFLINE
  BUSY
  ERROR
}

type Node {
  id: ID!
  partyId: String!
  address: String!
  status: NodeStatus!
  lastSeen: String!
  signingPublicKey: String!
}

input RegisterNodeInput {
  """
  Адрес ноды для подключения (обязательный)
  """
  address: String!
  """
  Party ID ноды (опционально - получается от ноды автоматически)
  """
  partyId: String
}

# ============================================
# Управление сессиями
# ============================================

enum SessionStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
}

enum SessionType {
  KEYGEN
  SIGNING
  RESHARING
}

# ============================================
# Результаты MPC операций
# ============================================

type KeygenResult {
  sessionId: ID!
  publicKey: String!
  address: String!
  threshold: Int!
  totalParties: Int!
}

type SigningResult {
  sessionId: ID!
  signature: String!
  r: String!
  s: String!
  v: Int!
}

input StartSigningInput {
  """
  Ethereum адрес кошелька для подписания (публичный ключ должен быть сгенерирован ранее)
  """
  address: String!
  """
  Сообщение для подписания (hex или UTF-8 строка)
  """
  message: String!
  """
  Список party ID участников подписания (опционально - используются все ноды с share для этого адреса)
  """
  participants: [String!]
}

input StartKeygenInput {
  """
  Список party ID участников генерации ключей.
  Если не указан - используются все зарегистрированные ноды.
  """
  participants: [String!]
  """
  Пороговое значение (минимальное количество участников для подписания).
  Должно быть <= количества участников.
  """
  threshold: Int!
  """
  Эллиптическая кривая для ключа: secp256k1, ed25519 и др.
  По умолчанию: secp256k1
  """
  curve: String
}

# ============================================
# Запросы
# ============================================

type Query {
  # Запросы нод
  nodes: [Node!]!
  node(id: ID!): Node
}

# ============================================
# Мутации
# ============================================

type Mutation {
  # Управление нодами
  registerNode(input: RegisterNodeInput!): Node!
  deleteNode(id: ID!): Node

  # MPC операции
  """
  Запускает распределённую генерацию ключей (DKG) между MPC нодами.
  Возвращает результат с публичным ключом и адресом.
  """
  startKeygen(input: StartKeygenInput!): KeygenResult!

  """
  Запускает распределённое подписание сообщения (TSS) между MPC нодами.
  Требует, чтобы для указанного адреса были сгенерированы ключи.
  """
  startSigning(input: StartSigningInput!): SigningResult!
}
