# GraphQL схема для MPC Оркестратора
# Управляет MPC нодами и координирует TSS операции

# ============================================
# Управление нодами
# ============================================

enum NodeStatus {
  ONLINE
  OFFLINE
  BUSY
  ERROR
}

type Node {
  id: ID!
  partyId: String!
  address: String!
  publicKey: String!
  status: NodeStatus!
  lastSeen: String!
}

input RegisterNodeInput {
  """
  Адрес ноды для подключения (обязательный)
  """
  address: String!
  """
  Party ID ноды (опционально - получается от ноды автоматически)
  """
  partyId: String
  """
  Публичный ключ ноды (опционально - получается от ноды автоматически)
  """
  publicKey: String
}

# ============================================
# Управление сессиями
# ============================================

enum SessionStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
}

enum SessionType {
  KEYGEN
  SIGNING
  RESHARING
}

type Session {
  id: ID!
  type: SessionType!
  status: SessionStatus!
  participants: [String!]!
  threshold: Int!
  createdAt: String!
  completedAt: String
}

input CreateSessionInput {
  type: SessionType!
  participants: [String!]!
  threshold: Int!
}

# ============================================
# Результаты MPC операций
# ============================================

type KeygenResult {
  sessionId: ID!
  publicKey: String!
  address: String!
  threshold: Int!
  totalParties: Int!
}

input StartKeygenInput {
  """
  Список party ID участников генерации ключей.
  Если не указан - используются все зарегистрированные ноды.
  """
  participants: [String!]
  """
  Пороговое значение (минимальное количество участников для подписания).
  Должно быть <= количества участников.
  """
  threshold: Int!
  """
  Эллиптическая кривая для ключа: secp256k1, ed25519 и др.
  По умолчанию: secp256k1
  """
  curve: String
}

# ============================================
# Запросы
# ============================================

type Query {
  # Запросы нод
  nodes: [Node!]!
  node(id: ID!): Node
}

# ============================================
# Мутации
# ============================================

type Mutation {
  # Управление нодами
  registerNode(input: RegisterNodeInput!): Node!
  deleteNode(id: ID!): Node

  # Управление сессиями
  createSession(input: CreateSessionInput!): Session!

  # MPC операции
  """
  Запускает распределённую генерацию ключей (DKG) между MPC нодами.
  Возвращает результат с публичным ключом и адресом.
  """
  startKeygen(input: StartKeygenInput!): KeygenResult!
}
